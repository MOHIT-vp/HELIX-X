# Backend runtime configuration. Relative paths resolve from this repository root.
GRAPHRAG_MODE=auto
GRAPHRAG_DATA_DIR=./data
GRAPHRAG_GRAPH_FILE=hetionet_data.pt
GRAPHRAG_MAPPINGS_FILE=node_mappings.json
GRAPHRAG_WEIGHTS_PATH=./assets/model_epoch8_score0.3792.pt
GRAPHRAG_ALLOW_DEMO_GRAPH=true
GRAPHRAG_HOST=127.0.0.1
GRAPHRAG_PORT=8000
GRAPHRAG_DEVICE=auto
GRAPHRAG_LOG_LEVEL=INFO
GRAPHRAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend runtime configuration.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
